<Application x:Class="ColorPickerApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="LightThemeBackground" Color="#FFF5F5F5" />
        <SolidColorBrush x:Key="LightThemeForeground" Color="#FF222222" />
        <SolidColorBrush x:Key="DarkThemeBackground" Color="#FF1E1E1E" />
        <SolidColorBrush x:Key="DarkThemeForeground" Color="#FFF5F5F5" />
        <Style x:Key="ThemeTextBlock" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
        </Style>
        <Style x:Key="ThemeLabel" TargetType="Label" BasedOn="{StaticResource ThemeTextBlock}" />
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeForegroundBrush}" />
        </Style>
        <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#FFF5F5F5" />
        <SolidColorBrush x:Key="ThemeForegroundBrush" Color="#FF222222" />
    </Application.Resources>
</Application>
